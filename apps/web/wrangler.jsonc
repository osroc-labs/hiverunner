{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hiveworker",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hiveworker",
      "database_id": "REPLACE_WITH_YOUR_PRODUCTION_D1_DATABASE_ID",
      "migrations_dir": "migrations",
      "migrations_pattern": "migrations/*/migration.sql",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "APP_DATABASE",
        "class_name": "AppDatabase",
      },
    ],
  },
  "exports": {
    "AppDatabase": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "send_email": [{ "name": "EMAIL" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
  "account_id": "865d0c927a18e87c0a0701b8d1f18ee9",
  "vars": {
    "APP_URL": "https://hiveworkr.thecomputerplumbers.com",
    "EMAIL_FROM": "auth@thecomputerplumbers.com",
  },
  "env": {
    "staging": {
      "name": "hiveworker-staging",
      "vars": {
        "APP_URL": "https://hiveworkr-staging.thecomputerplumbers.com",
        "EMAIL_FROM": "auth@thecomputerplumbers.com",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hiveworker-staging",
          "database_id": "REPLACE_WITH_YOUR_STAGING_D1_DATABASE_ID",
          "migrations_dir": "migrations",
          "migrations_pattern": "migrations/*/migration.sql",
        },
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "APP_DATABASE",
            "class_name": "AppDatabase",
          },
        ],
      },
      "send_email": [
        {
          "name": "EMAIL",
        },
      ],
      "routes": [
        {
          "pattern": "hiveworkr-staging.thecomputerplumbers.com",
          "custom_domain": true,
        },
      ],
    },
  },
  "routes": [
    {
      "pattern": "hiveworkr.thecomputerplumbers.com",
      "custom_domain": true,
    },
  ],
}
