# The VM's one network card and nothing else. The bridges and veth pairs
# Docker makes (docker0, br-*, veth*) match neither name, and must not:
# they are Docker's to address.
[Match]
Name=en* eth*

[Network]
DHCP=yes

[DHCPv4]
# Every VM is a clone of one disk. Identify it by its network card, which the
# host sets per VM, or every clone asks for the same address and two running
# at once collide.
ClientIdentifier=mac
